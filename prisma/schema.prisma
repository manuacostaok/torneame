// ============================================================
// TORNEAME
// Prisma + MongoDB
// Compatible con Prisma 5.22
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  PLAYER
  ORGANIZER
  ADMIN
}

enum OrganizerPlan {
  FREE
  PRO
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  LEAGUE
  GROUPS
}

enum TournamentLocationType {
  ONLINE
  PRESENCIAL
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum MatchStatus {
  PENDING
  LIVE
  FINISHED
}

enum SponsorTier {
  BASIC
  FEATURED
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  email        String  @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  phone        String?

  whatsappOptIn Boolean  @default(false)
  role          UserRole @default(PLAYER)

  referralCode String @unique @default(cuid())

  referredById String? @db.ObjectId
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  referrals User[] @relation("UserReferrals")

  referralCreditsArs Int @default(0)

  createdAt DateTime @default(now())

  playerProfile    PlayerProfile?
  organizerProfile OrganizerProfile?

  notifications Notification[]

  following Follow[] @relation("FollowerUser")

  pushSubscriptions PushSubscription[]

  comments Comment[]

  productOrders ProductOrder[]
}

// ============================================================
// PLAYER PROFILE
// ============================================================

model PlayerProfile {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @unique @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  gamertag  String
  bio       String?
  eloRating Int     @default(1000)

  registrations Registration[]

  achievements Achievement[]
}

// ============================================================
// ORGANIZER PROFILE
// ============================================================

model OrganizerProfile {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @unique @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  orgName String
  slug    String @unique

  logoUrl String?
  bio     String?

  verified Boolean @default(false)

  plan OrganizerPlan @default(FREE)

  customDomain  String?
  planExpiresAt DateTime?

  networkId String? @db.ObjectId

  network Network? @relation(fields: [networkId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  tournaments Tournament[]

  followers Follow[] @relation("FollowedOrganizer")

  products Product[]
}

// ============================================================
// FOLLOW
// ============================================================

model Follow {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  followerId String @db.ObjectId

  follower User @relation("FollowerUser", fields: [followerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  organizerId String @db.ObjectId

  organizer OrganizerProfile @relation("FollowedOrganizer", fields: [organizerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([followerId, organizerId])
}

// ============================================================
// GAME
// ============================================================

model Game {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name          String
  platform      String?
  coverImageUrl String?

  tournaments Tournament[]

  friendTournaments FriendTournament[]
}

// ============================================================
// TOURNAMENT
// ============================================================

model Tournament {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizerId String @db.ObjectId

  organizer OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  gameId String @db.ObjectId

  game Game @relation(fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name        String
  description String?

  format TournamentFormat
  mode   String

  entryFee      Float @default(0)
  prizePoolBase Float @default(0)

  prizePoolDynamicRule Json?

  locationType TournamentLocationType

  venueAddress String?

  startsAt             DateTime
  registrationDeadline DateTime

  maxPlayers Int

  status TournamentStatus @default(DRAFT)

  createdAt DateTime @default(now())

  registrations Registration[]

  bracket Bracket?

  comments Comment[]

  sponsors Sponsor[]
}

// ============================================================
// REGISTRATION
// ============================================================

model Registration {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tournamentId String @db.ObjectId

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  playerId String @db.ObjectId

  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  payment Payment?

  checkedInAt DateTime?

  seed Int?

  createdAt DateTime @default(now())

  @@unique([tournamentId, playerId])
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  registrationId String @unique @db.ObjectId

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  amount Float

  provider String @default("mercadopago")

  status PaymentStatus @default(PENDING)

  commissionAmount Float @default(0)

  createdAt DateTime @default(now())
}

// ============================================================
// BRACKET
// ============================================================

model Bracket {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tournamentId String @unique @db.ObjectId

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  structureJson Json

  currentRound Int @default(1)

  matches Match[]
}

// ============================================================
// MATCH
// ============================================================

model Match {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  bracketId String @db.ObjectId

  bracket Bracket @relation(fields: [bracketId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  round Int

  playerAId String? @db.ObjectId
  playerBId String? @db.ObjectId
  winnerId  String? @db.ObjectId

  scoreA Int?
  scoreB Int?

  status MatchStatus @default(PENDING)

  scheduledAt DateTime?
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type String

  payload Json

  readAt DateTime?

  createdAt DateTime @default(now())
}

// ============================================================
// ACHIEVEMENT
// ============================================================

model Achievement {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  playerId String @db.ObjectId

  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type String

  tournamentId String? @db.ObjectId

  earnedAt DateTime @default(now())
}

// ============================================================
// COMMENT
// ============================================================

model Comment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tournamentId String @db.ObjectId

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  authorId String @db.ObjectId

  author User @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  body String

  createdAt DateTime @default(now())
}

// ============================================================
// FRIEND TOURNAMENT
// ============================================================

model FriendTournament {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  hostUserId String? @db.ObjectId

  gameId String @db.ObjectId

  game Game @relation(fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  mode String

  playerNames Json

  teams Json

  bracketJson Json

  createdAt DateTime @default(now())
}

// ============================================================
// PUSH SUBSCRIPTION
// ============================================================

model PushSubscription {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  endpoint String @unique

  p256dh String

  auth String

  createdAt DateTime @default(now())
}

// ============================================================
// SPONSOR
// ============================================================

model Sponsor {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tournamentId String @db.ObjectId

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name String

  logoUrl String?

  linkUrl String?

  tier SponsorTier @default(BASIC)

  createdAt DateTime @default(now())
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizerId String @db.ObjectId

  organizer OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name String

  description String?

  price Float

  imageUrl String?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  orders ProductOrder[]
}

// ============================================================
// PRODUCT ORDER
// ============================================================

model ProductOrder {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  productId String @db.ObjectId

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  buyerId String @db.ObjectId

  buyer User @relation(fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
}

// ============================================================
// NETWORK
// ============================================================

model Network {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String

  slug String @unique

  logoUrl String?

  bio String?

  organizers OrganizerProfile[]
}
