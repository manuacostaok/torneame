# Base de datos
DATABASE_URL="postgresql://usuario:password@host:5432/torneame"

# Cloudinary — subida real de imágenes (flyer del torneo, foto de perfil).
# Subida firmada: el navegador le pide una firma de un solo uso a nuestro
# servidor (app/actions/cloudinary.ts) y con esa firma sube el archivo
# directo a Cloudinary, sin pasar por nuestro servidor. El API secret vive
# solo acá, nunca llega al navegador. Los tres valores salen del dashboard
# de Cloudinary → Settings → Access Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Gemini — genera el texto para compartir el torneo y ayuda a
# revisar comprobantes de pago (app/actions/ai.ts). Opcional: sin esto,
# esas dos funciones muestran un error pero el resto de la app sigue
# funcionando normal. Se saca gratis en aistudio.google.com (no pide
# tarjeta), con límite de pedidos por minuto/día.
GEMINI_API_KEY=""

# Auth.js — generar con `npx auth secret`, nunca reusar entre entornos
AUTH_SECRET=""

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=""
# Secreto de firma del webhook — se configura en el panel de Mercado Pago
# al crear la integración. Sin esto, el webhook rechaza todo (falla seguro,
# no silencioso: mejor un webhook que no confirma pagos que uno que confirma
# pagos falsos).
MERCADOPAGO_WEBHOOK_SECRET=""

# URL pública de la app (se usa para armar los back_urls de Mercado Pago
# y la notification_url del webhook)
APP_URL="https://torneame.app"

# WhatsApp (Twilio) — opcional. Sin esto configurado, las notificaciones
# simplemente no se mandan por WhatsApp (se loguea un warning), la app
# sigue funcionando normal con solo las notificaciones in-app.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Notificaciones push del navegador. Se generan UNA vez por proyecto con:
#   npx web-push generate-vapid-keys
# La pública también tiene que estar disponible en el cliente, por eso el
# prefijo NEXT_PUBLIC_ (Next.js expone al navegador solo las que empiezan así).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
